import os
import shlex
import sys
from pathlib import Path
from snakemake.utils import min_version

min_version("8.0")


configfile: "config/config.yaml"


# Plot outputs live in a category subdir (results/plots/{category}/{peak}); pin
# the category to the known set and keep peak_id from swallowing the slash.
wildcard_constraints:
    category="drivers|heritable_no_driver|random",
    peak_id=r"[^/]+",


# All outputs are namespaced under a run name so separate runs (test,
# hap-selective-30, the cluster run, …) get their own results/ + temp/ subtree
# and never clobber or orphan each other. Each pixi task sets `run_name=<task>`;
# the default lands under results/default/.
RUN = config.get("run_name", "default")
RESULTS = f"results/{RUN}"
TEMP = f"temp/{RUN}"

# Interactive HTML plots are ~4 MB each; OFF by default (the static PDF is always
# written). Enable with `--config plot_html=true`. (str() because --config values
# arrive as strings, where bool("false") would be truthy.)
PLOT_HTML = str(config.get("plot_html", "false")).lower() in ("true", "1", "yes")


def count_unique_seqs(fa_path: str) -> int:
    """Count unique sequences in a FASTA (handles multi-line format)."""
    seqs: set[str] = set()
    parts: list[str] = []
    with open(fa_path) as fh:
        for line in fh:
            line = line.rstrip()
            if line.startswith(">"):
                if parts:
                    seqs.add("".join(parts))
                parts = []
            else:
                parts.append(line)
    if parts:
        seqs.add("".join(parts))
    return len(seqs)


def count_unique_seqs_phylip(phy_path: str) -> int:
    """Count unique sequences in a one-line-per-tip PHYLIP file."""
    seqs: set[str] = set()
    with open(phy_path) as fh:
        next(fh, None)  # skip the header `<n_taxa> <n_cols>`
        for line in fh:
            parts = line.strip().split(None, 1)
            if len(parts) == 2:
                seqs.add(parts[1])
    return len(seqs)


# ── static peak set (resolved at parse time, no checkpoint) ───────────────────


def _sanitize_peak(p: str) -> str:
    """Mirror extract_fastas.sanitize: peak_ids become filenames, `#`→`_`."""
    return p.replace("#", "_")


def _run_peak_ids():
    """The peak set for this run, resolved at PARSE time so the per-peak DAG is
    fully static — no ``extract_fastas`` checkpoint, whose re-evaluation on
    resume hangs at "Updating checkpoint dependencies" once the peak count is in
    the 100Ks. Resolution priority:

      1. ``preextracted_dir`` → the source dir's ``*.fa`` (exists before the run).
      2. the extract_fastas survivor manifest ``results/{run}/fastas/peak_ids.txt``
         — EXACT (every listed peak has a FASTA). This is the resume case.
      3. ``config["peak_ids"]`` — the pre-built request list, used on a fresh run
         before extraction has written the manifest. A requested peak that
         extraction later drops (all-NA / below ``min_seqs``) fails its own
         ``fasta_ready`` job in isolation; re-running the pipeline then reads the
         (now-written) survivor manifest and the DAG is clean.
      4. last resort: glob the fastas dir.
    """
    pre = config.get("preextracted_dir")
    if pre:
        src = Path(pre)
        return sorted(
            _sanitize_peak(fa.stem)
            for fa in src.glob("*.fa")
            if (src / f"{fa.stem}.tsv").exists()
        )
    manifest = Path(RESULTS + "/fastas/peak_ids.txt")
    if manifest.exists():
        return [ln.strip() for ln in manifest.read_text().splitlines() if ln.strip()]
    pi = config.get("peak_ids")
    if pi and Path(pi).exists():
        return [
            _sanitize_peak(ln.strip())
            for ln in Path(pi).read_text().splitlines()
            if ln.strip()
        ]
    return sorted(_sanitize_peak(fa.stem) for fa in Path(RESULTS).glob("fastas/*.fa"))


def _all_re_variants(wildcards):
    """Every peak's re_variants table — the input to aggregate_results.

    Requiring all of these forces the full per-peak computation (tree → phylo_mm
    → re_variants) for the WHOLE peak set: stats for all, regardless of which
    peaks get plotted. The peak set is static (from ``_run_peak_ids``), so this
    no longer triggers a 180K checkpoint re-expansion."""
    return expand(RESULTS + "/re_variants/{peak_id}.tsv", peak_id=_run_peak_ids())


# Plot categories → the manifest aggregate_results writes for each. Plots are
# rendered ONLY for peaks listed here (drivers + heritable-no-driver + random),
# not for all 180K peaks.
PLOT_CATEGORIES = {
    "drivers": RESULTS + "/tables/plot_drivers.txt",
    "heritable_no_driver": RESULTS + "/tables/plot_heritable_no_driver.txt",
    "random": RESULTS + "/tables/plot_random.txt",
}


def aggregate_outputs(wildcards):
    """Final targets: the unified parquet table + the categorized plots.

    The table pulls the full per-peak stats (via aggregate_results → all
    re_variants). The plots are data-driven: aggregate_results classifies peaks
    and writes the three manifests, which we read here to expand the plot paths
    into their category subdirs."""
    checkpoints.aggregate_results.get(**wildcards)
    out = [
        RESULTS + "/tables/re_variants.parquet",
        RESULTS + "/tables/re_variants.tsv.gz",
    ]
    for cat, manifest in PLOT_CATEGORIES.items():
        peaks = [
            line.strip() for line in Path(manifest).read_text().splitlines() if line.strip()
        ]
        out += expand(RESULTS + "/plots/{cat}/{peak_id}.pdf", cat=cat, peak_id=peaks)
        if PLOT_HTML:
            out += expand(RESULTS + "/plots/{cat}/{peak_id}.html", cat=cat, peak_id=peaks)
    return out


# ── rules ──────────────────────────────────────────────────────────────────────


rule all:
    input:
        aggregate_outputs,


def _ingest_preextracted(src_dir: Path, dst_dir: Path) -> int:
    """Symlink {peak_id}.fa / {peak_id}.tsv from src_dir into dst_dir.

    Used when an upstream pipeline (e.g. PARE) has already produced per-group
    FASTA + actuation TSV files in this directory layout. Returns the number
    of FASTA pairs linked. Also writes ``peak_ids.txt`` (the run manifest
    that ``aggregate_outputs`` reads).
    """
    src_dir = Path(src_dir).resolve()
    dst_dir.mkdir(parents=True, exist_ok=True)
    linked: list[str] = []
    for fa in sorted(src_dir.glob("*.fa")):
        peak = fa.stem
        tsv = src_dir / f"{peak}.tsv"
        if not tsv.exists():
            continue
        for src, dst in ((fa, dst_dir / fa.name), (tsv, dst_dir / tsv.name)):
            if dst.is_symlink() or dst.exists():
                dst.unlink()
            dst.symlink_to(src)
        linked.append(peak)
    (dst_dir / "peak_ids.txt").write_text("\n".join(linked) + "\n")
    return len(linked)


def _extract_fastas_input(wildcards):
    """Either the bgzipped union BED, or the pre-extracted directory."""
    pre = config.get("preextracted_dir")
    if pre:
        return str(Path(pre).resolve())
    return config["input_table"]


def _peak_ids_input(wildcards):
    """Track the peak_ids file as a checkpoint input when supplied.

    Without this, switching between two `peak_ids` files on the *same*
    input_table wouldn't re-trigger extraction and the manifest would not
    refresh.
    """
    pi = config.get("peak_ids")
    return [pi] if pi else []


def _highlight_input(wildcards):
    """Same idea as _peak_ids_input but for the highlight TSV."""
    hf = config.get("highlight_file")
    return [hf] if hf else []


rule extract_fastas:
    """One-pass extraction of per-peak FASTA + actuation TSV from the union-peaks table.

If `preextracted_dir` is set, this becomes a noop wrapper that symlinks
pre-extracted FASTA/TSV pairs into `results/fastas/` (e.g. per-paralog-group
files emitted by PARE's `extract_paralog_msas` rule).

NOT a checkpoint: the peak set is read statically from the survivor manifest
(`peak_ids.txt`, this rule's output) by `_run_peak_ids`, so the per-peak DAG is
built once instead of re-expanded on every resume. `rule fasta_ready` exposes
the per-peak FASTAs (written here as a side effect) as individual targets.
"""
    input:
        src=_extract_fastas_input,
        peak_ids=_peak_ids_input,
        highlight=_highlight_input,
        script=workflow.source_path("scripts/extract_fastas.py"),
    output:
        # Declare every requested peak's FASTA/TSV (peak set read at parse from
        # the peak-ids file — cheap even at 100K+ lines) so this rule is their
        # producer: that's what lets ONE `snakemake` build the whole per-peak DAG
        # with no checkpoint. A peak that yields nothing (all-NA, or below
        # min_seqs) would leave a missing declared output; extract_fastas.py
        # catches that and exits with the offending ids so you drop them from the
        # list. At min_seqs=1 (the cluster default) only a truly empty peak — one
        # with zero non-NA primary sequences — can fail this way, which the HSCA
        # set shouldn't contain.
        fa=expand(RESULTS + "/fastas/{peak_id}.fa", peak_id=_run_peak_ids()),
        tsv=expand(RESULTS + "/fastas/{peak_id}.tsv", peak_id=_run_peak_ids()),
        done=touch(RESULTS + "/fastas/.done"),
        manifest=RESULTS + "/fastas/peak_ids.txt",
    threads: config.get("bgzip_threads", 16)
    resources:
        mem_mb=32768,
        runtime=480,
    params:
        # Expose the scalar config the run block depends on as params so
        # snakemake reruns the checkpoint when any of them change (a `run:`
        # block doesn't track raw config reads — same gap as external scripts).
        preextracted=config.get("preextracted_dir"),
        min_seqs=config.get("min_seqs", 2),
        primary_only=config.get("primary_only", True),
        haplotype_distinct=config.get("haplotype_distinct"),
    run:
        if params.preextracted:
            n = _ingest_preextracted(Path(input.src), Path(RESULTS + "/fastas"))
            print(f"linked {n} pre-extracted FASTA/TSV pairs from {input.src}")
        else:
            # Sort by consensus_peak_id (col 5) so each peak's rows are
            # consecutive for the streaming extractor — the production union BED
            # is asm-coord-sorted, not peak-sorted. `sed -u 1q` passes the
            # header through first, then `sort` orders the data rows.
            parts = [
                f"bgzip -cd -@ {threads} {shlex.quote(str(input.src))}",
                "| (sed -u 1q; sort -t$'\\t' -k5,5 -S 50%)",
                f"| python {shlex.quote(str(input.script))}",
                f"--outdir {RESULTS}/fastas",
                f"--min-seqs {params.min_seqs}",
            ]
            if params.primary_only:
                parts.append("--primary-only")
            if input.peak_ids:
                parts.append(f"--peak-ids {shlex.quote(str(input.peak_ids[0]))}")
            if params.haplotype_distinct:
                parts.append(
                    f"--haplotype-distinct {shlex.quote(str(params.haplotype_distinct))}"
                )
            if input.highlight:
                parts.append(
                    f"--highlight-file {shlex.quote(str(input.highlight[0]))}"
                )
            shell(" ".join(parts))


rule add_flanks:
    """Add `config["flank"]` bp of assembly context each side of the peak.

Pulls the flanked sequence per haplotype from the AGC archive keyed by the
PanSN asm_chr in the per-peak TSV. Only instantiated when `flank > 0` (the
`_mafft_input` switch routes mafft straight to the RE-only FASTA otherwise),
so the checkpoint's peak manifest stays independent of flank.
"""
    input:
        fa=RESULTS + "/fastas/{peak_id}.fa",
        tsv=RESULTS + "/fastas/{peak_id}.tsv",
        script=workflow.source_path("scripts/add_flanks.py"),
    output:
        fa=temp(TEMP + "/flanked/{peak_id}.fa"),
    group:
        "peak_chain"
    threads: 4
    resources:
        mem_mb=4096,
        runtime=30,
    params:
        flank=config.get("flank", 0),
        agc=config.get("agc", ""),
    shell:
        """
        python {input.script} \
            --fa      {input.fa} \
            --tsv     {input.tsv} \
            --agc     {params.agc} \
            --flank   {params.flank} \
            --threads {threads} \
            --out     {output.fa}
        """


def _mafft_input(wildcards):
    """RE-only FASTA, or the flanked FASTA when flanking is enabled."""
    if int(config.get("flank", 0)) > 0:
        return f"{TEMP}/flanked/{wildcards.peak_id}.fa"
    return f"{RESULTS}/fastas/{wildcards.peak_id}.fa"


rule mafft:
    """Align sequences for a single peak with MAFFT."""
    input:
        fa=_mafft_input,
    output:
        fa=temp(TEMP + "/aligned/{peak_id}.fa"),
    group:
        "peak_chain"
    threads: 4
    resources:
        mem_mb=8192,
        runtime=60,
    params:
        maxiterate=config.get("mafft_maxiterate", 1000),
    shell:
        """
        mafft --maxiterate {params.maxiterate} --reorder --auto --adjustdirection \
            --thread {threads} {input.fa} > {output.fa}
        """


rule encode_indels:
    """Simmons-Ochoterena (2000) simple indel coding for the MAFFT alignment.

Each distinct contiguous gap interval becomes a binary character (state 1
if the taxon carries exactly that gap, 0 if it has continuous sequence
there, ? if the taxon carries a larger gap that strictly contains the
interval). Singleton gaps are dropped. The resulting partition pairs
GTR+I+G on DNA with GTR2 on indels in IQ-TREE — without it, IQ-TREE
treats gaps as missing data and indel-only splits collapse to zero-length
branches.
"""
    input:
        fa=TEMP + "/aligned/{peak_id}.fa",
        script=workflow.source_path("scripts/encode_indels.py"),
    output:
        nex=temp(TEMP + "/coded/{peak_id}/{peak_id}.nex"),
        nuc=temp(TEMP + "/coded/{peak_id}/{peak_id}_nucleic.phy"),
        indel=temp(TEMP + "/coded/{peak_id}/{peak_id}_indel.phy"),
    group:
        "peak_chain"
    threads: 1
    resources:
        mem_mb=2048,
        runtime=10,
    params:
        peak_id=lambda wc: wc.peak_id,
        out_dir=lambda wc: f"{TEMP}/coded/{wc.peak_id}",
    shell:
        """
        python {input.script} \
            --aligned {input.fa} \
            --peak-id {params.peak_id} \
            --out-dir {params.out_dir}
        """


rule iqtree:
    """Infer a maximum-likelihood tree from a partitioned (DNA + indel) matrix.

Reads the partition Nexus + PHYLIPs produced by `encode_indels`. The models
are pinned by the charpartition (`GTR+I+G` on the DNA partition, `GTR2+ASC`
on the binary indel partition), so IQ-TREE estimates model parameters and
branch lengths but does NOT run model selection. (If the alignment is later
widened with flanking sequence, switch the DNA partition to ModelFinder by
dropping its model from the charpartition.)
"""
    input:
        nex=TEMP + "/coded/{peak_id}/{peak_id}.nex",
        nuc=TEMP + "/coded/{peak_id}/{peak_id}_nucleic.phy",
        indel=TEMP + "/coded/{peak_id}/{peak_id}_indel.phy",
    output:
        # unrooted ML tree — temp: superseded by the rooted .nwk (root_tree keeps
        # branch lengths + bootstrap); only root_tree + re_iqtree-fallback read it.
        treefile=temp(TEMP + "/trees/{peak_id}.treefile"),
    group:
        "peak_chain"
    threads: 4
    resources:
        mem_mb=16384,
        runtime=120,
    params:
        prefix=lambda wc: os.path.abspath(f"{TEMP}/trees/{wc.peak_id}"),
        peak_id=lambda wc: wc.peak_id,
        # Enable ultrafast bootstrap only when the alignment has >=4 unique sequences;
        # IQ-TREE deduplicates internally and refuses bootstrap on fewer distinct taxa.
        bootstrap=lambda wc, input: (
            "-B 1000" if count_unique_seqs_phylip(str(input.nuc)) >= 4 else ""
        ),
    shell:
        # IQ-TREE needs the .phy files to live alongside the .nex (the nex
        # references them by relative basename), so cd into coded/{peak}.
        # `--prefix` takes an absolute path so the tree lands in results/trees/.
        # We can't use `shadow: minimal` here — it conflicts with the
        # absolute-path prefix. Instead, IQ-TREE writes a few auxiliary
        # files (.log/.iqtree/.bionj/.mldist/.model.gz/.ckp.gz) next to
        # the treefile; we delete them after the run.
        # --redo: overwrite prior partial runs. Models are fixed by the .nex
        # charpartition (GTR+I+G on DNA, GTR2+ASC on indels), so no -m needed.
        """
        (cd $(dirname {input.nex}) && iqtree -p {params.peak_id}.nex \
            --prefix {params.prefix} -T AUTO --threads-max {threads} {params.bootstrap} --redo)
        # Delete every IQ-TREE aux file sharing the prefix except the treefile,
        # so new aux extensions across IQ-TREE versions don't leak.
        find "$(dirname {params.prefix})" -maxdepth 1 \
            -name "$(basename {params.prefix}).*" \
            ! -name "$(basename {params.prefix}).treefile" -delete
        """


rule root_tree:
    """Root the ML tree ONCE into a canonical rooted Newick.

Both phylo_mm and plot read THIS rooted tree and neither re-roots, so the
clade each branch represents is identical everywhere — fixing the scattered
leader lines / detached annotations / mirror branches that came from
phylo_mm and the plot rooting independently. Rooted on the ANCESTRAL PROXY:
the haplotype(s) closest to the MSA consensus (the modal allele ≈ ancestral
in young intraspecific variation), falling back to midpoint when that set
isn't monophyletic. This polarizes the tree ancestral→derived without a
molecular-clock assumption, so the reference allele sits at the base on
every peak. Needs the alignment to compute the consensus.
"""
    input:
        treefile=TEMP + "/trees/{peak_id}.treefile",
        alignment=TEMP + "/aligned/{peak_id}.fa",
        script=workflow.source_path("scripts/root_tree.R"),
    output:
        rooted=RESULTS + "/trees/{peak_id}.rooted.nwk",
    group:
        "peak_chain"
    threads: 1
    resources:
        mem_mb=1024,
        runtime=10,
    shell:
        # OpenBLAS/MKL ignore the rule's threads and grab every core — cap them.
        "OMP_NUM_THREADS={threads} OPENBLAS_NUM_THREADS={threads} "
        "MKL_NUM_THREADS={threads} "
        "Rscript {input.script} {input.treefile} {input.alignment} {output.rooted}"


# ── RE-only tree (for the RE-only heritability test) ─────────────────────────
# Same mafft alignment, sliced to the RE band, then run through the identical
# encode → iqtree → root pipeline, so H²ₚ(RE) and H²ₚ(region) differ only in
# scope. Only built when flank > 0 (with no flank, the RE *is* the whole
# alignment and the main tree already serves — see `_re_tree`/`_re_alignment`).


rule re_trim:
    """Slice the flanked MSA down to the RE columns."""
    input:
        fa=TEMP + "/aligned/{peak_id}.fa",
        script=workflow.source_path("scripts/trim_to_re.py"),
    output:
        fa=temp(TEMP + "/re/aligned/{peak_id}.fa"),
    group:
        "peak_chain"
    threads: 1
    resources:
        mem_mb=1024,
        runtime=10,
    params:
        flank=config.get("flank", 0),
    shell:
        "python {input.script} --aln {input.fa} --flank {params.flank} --out {output.fa}"


rule re_encode_indels:
    """encode_indels on the RE-only alignment (mirrors rule encode_indels)."""
    input:
        fa=TEMP + "/re/aligned/{peak_id}.fa",
        script=workflow.source_path("scripts/encode_indels.py"),
    output:
        nex=temp(TEMP + "/re/coded/{peak_id}/{peak_id}.nex"),
        nuc=temp(TEMP + "/re/coded/{peak_id}/{peak_id}_nucleic.phy"),
        indel=temp(TEMP + "/re/coded/{peak_id}/{peak_id}_indel.phy"),
    group:
        "peak_chain"
    threads: 1
    resources:
        mem_mb=2048,
        runtime=10,
    params:
        peak_id=lambda wc: wc.peak_id,
        out_dir=lambda wc: f"{TEMP}/re/coded/{wc.peak_id}",
    shell:
        """
        python {input.script} \
            --aligned {input.fa} \
            --peak-id {params.peak_id} \
            --out-dir {params.out_dir}
        """


rule re_iqtree:
    """ML tree from the RE-only partitioned matrix (mirrors rule iqtree).

The RE band can be (near-)monomorphic (epigenetic peaks), where IQ-TREE has
<2 distinct sequences and errors. We fall back to the whole-region treefile
then — phylo_mm sees the RE has <2 unique sequences and reports H²ₚ(RE) as
unavailable regardless of the tree's topology, so the fallback only needs
the right tip set.
"""
    input:
        nex=TEMP + "/re/coded/{peak_id}/{peak_id}.nex",
        nuc=TEMP + "/re/coded/{peak_id}/{peak_id}_nucleic.phy",
        indel=TEMP + "/re/coded/{peak_id}/{peak_id}_indel.phy",
        main_tree=TEMP + "/trees/{peak_id}.treefile",
    output:
        # internal: only re_root_tree → phylo_mm read it, nothing downstream.
        treefile=temp(TEMP + "/re/trees/{peak_id}.treefile"),
    group:
        "peak_chain"
    threads: 4
    resources:
        mem_mb=16384,
        runtime=120,
    params:
        prefix=lambda wc: os.path.abspath(f"{TEMP}/re/trees/{wc.peak_id}"),
        peak_id=lambda wc: wc.peak_id,
        bootstrap=lambda wc, input: (
            "-B 1000" if count_unique_seqs_phylip(str(input.nuc)) >= 4 else ""
        ),
    shell:
        """
        if (cd $(dirname {input.nex}) && iqtree -p {params.peak_id}.nex \
                --prefix {params.prefix} -T AUTO --threads-max {threads} {params.bootstrap} --redo); then
            find "$(dirname {params.prefix})" -maxdepth 1 \
                -name "$(basename {params.prefix}).*" \
                ! -name "$(basename {params.prefix}).treefile" -delete
        else
            echo "[re_iqtree] {params.peak_id}: IQ-TREE failed (monomorphic RE?); using main tree" >&2
            cp {input.main_tree} {output.treefile}
        fi
        """


rule re_root_tree:
    """Ancestral-proxy root the RE-only tree (mirrors rule root_tree)."""
    input:
        treefile=TEMP + "/re/trees/{peak_id}.treefile",
        alignment=TEMP + "/re/aligned/{peak_id}.fa",
        script=workflow.source_path("scripts/root_tree.R"),
    output:
        # internal: only phylo_mm (H²_re scope) reads this, then it's done.
        rooted=temp(TEMP + "/re/trees/{peak_id}.rooted.nwk"),
    group:
        "peak_chain"
    threads: 1
    resources:
        mem_mb=1024,
        runtime=10,
    shell:
        # OpenBLAS/MKL ignore the rule's threads and grab every core — cap them.
        "OMP_NUM_THREADS={threads} OPENBLAS_NUM_THREADS={threads} "
        "MKL_NUM_THREADS={threads} "
        "Rscript {input.script} {input.treefile} {input.alignment} {output.rooted}"


def _re_tree(wildcards):
    """RE-only rooted tree: the trimmed-then-rebuilt tree when flank>0, else
    the main tree (with no flank the RE *is* the whole alignment)."""
    if config.get("flank", 0) > 0:
        return f"{TEMP}/re/trees/{wildcards.peak_id}.rooted.nwk"
    return f"{RESULTS}/trees/{wildcards.peak_id}.rooted.nwk"


def _re_alignment(wildcards):
    """RE-only alignment paired with `_re_tree`."""
    if config.get("flank", 0) > 0:
        return f"{TEMP}/re/aligned/{wildcards.peak_id}.fa"
    return f"{TEMP}/aligned/{wildcards.peak_id}.fa"


def _pclai_bed_for_plot(_wildcards):
    """Resolve the optional PCLAI bed path; only included as an input dep
    when configured AND present on disk so missing-data runs don't fail.

    Warns once (to stderr) when `pclai_bed` is configured but the file is
    missing, so a typo'd path doesn't silently drop the ancestry stripe."""
    p = config.get("pclai_bed")
    if not p:
        return []
    if Path(p).exists():
        return [p]
    if not config.get("_pclai_warned"):
        print(
            f"WARNING: pclai_bed={p!r} not found; PCLAI stripe disabled",
            file=sys.stderr,
        )
        config["_pclai_warned"] = True
    return []


rule phylo_mm:
    """Per-peak phylogenetic analysis via workflow/scripts/phylo_mm.R.

TSV header carries the 3-prior phylogenetic heritability sensitivity
(h2_alpha{1000,1,025}), the alpha.V=1 posterior ESS + a convergence flag,
and the LASSO branch-selection summary. Data rows are per-internal-branch:
a Welch t-test scan of clade-vs-rest actuation (p_fdr is the headline),
plus LASSO-selected branches with selectiveInference beta/CI. No per-peak
diagnostic PDF is emitted (it was redundant with the TSV header + the main
category plot, and would be 180K files at scale); pass --pdf to phylo_mm.R
by hand for ad-hoc debugging.
"""
    input:
        tree=RESULTS + "/trees/{peak_id}.rooted.nwk",
        actuation=RESULTS + "/fastas/{peak_id}.tsv",
        alignment=TEMP + "/aligned/{peak_id}.fa",
        re_tree=_re_tree,
        re_alignment=_re_alignment,
        script=workflow.source_path("scripts/phylo_mm.R"),
    output:
        tsv=RESULTS + "/phylo_mm/{peak_id}.tsv",
    group:
        "peak_chain"
    threads: 1
    resources:
        mem_mb=4096,
        runtime=90,
    params:
        min_cov=config.get("min_coverage", 4),
        flank=config.get("flank", 0),
        h2_width_max=config.get("h2_hpd_width_max", 0.5),
        h2_lower_min=config.get("h2_hpd_lower_min", 0.1),
    shell:
        """
        OMP_NUM_THREADS={threads} OPENBLAS_NUM_THREADS={threads} MKL_NUM_THREADS={threads} \
        Rscript {input.script} \
            --tree      {input.tree} \
            --actuation {input.actuation} \
            --alignment {input.alignment} \
            --re-tree      {input.re_tree} \
            --re-alignment {input.re_alignment} \
            --tsv       {output.tsv} \
            --peak-id   {wildcards.peak_id} \
            --min-cov   {params.min_cov} \
            --flank     {params.flank} \
            --h2-width-max {params.h2_width_max} \
            --h2-lower-min {params.h2_lower_min}
        """


rule re_variants:
    """Per-peak re_variants table: one row per unique RE sequence.

The clonable/validatable unit for plasmid work — each unique RE sequence with
its actuation, the driver allele(s) it carries (and the model-predicted
``driver_delta``), and the cheapest single-variable validation contrast
(``nearest_noncarrier_seq_id`` / ``clean_pair`` / ``minimal_edit``). Built from
already-produced files (alignment + actuation + phylo_mm TSV); no re-modeling.
"""
    input:
        aligned=TEMP + "/aligned/{peak_id}.fa",
        actuation=RESULTS + "/fastas/{peak_id}.tsv",
        phylo_mm=RESULTS + "/phylo_mm/{peak_id}.tsv",
        script=workflow.source_path("scripts/build_re_variants.py"),
    output:
        tsv=RESULTS + "/re_variants/{peak_id}.tsv",
    group:
        "peak_chain"
    threads: 1
    resources:
        mem_mb=2048,
        runtime=10,
    shell:
        """
        POLARS_MAX_THREADS={threads} python {input.script} \
            --aligned   {input.aligned} \
            --actuation {input.actuation} \
            --phylo-mm  {input.phylo_mm} \
            --out       {output.tsv}
        """


checkpoint aggregate_results:
    """Concatenate every peak's re_variants into one parquet + gzipped TSV, and
write the three plot manifests (drivers / heritable-no-driver / random) that
drive data-driven plotting. A checkpoint because the plot targets in `rule all`
depend on which peaks land in each manifest.
"""
    input:
        tables=_all_re_variants,
        script=workflow.source_path("scripts/aggregate_re_variants.py"),
    output:
        parquet=RESULTS + "/tables/re_variants.parquet",
        tsv=RESULTS + "/tables/re_variants.tsv.gz",
        drivers=RESULTS + "/tables/plot_drivers.txt",
        heritable=RESULTS + "/tables/plot_heritable_no_driver.txt",
        random=RESULTS + "/tables/plot_random.txt",
    resources:
        mem_mb=49152,  # reads all 180K per-peak TSVs into one concat
        runtime=240,
    params:
        rdir=RESULTS,
        random_n=config.get("random_n", 100),
        seed=config.get("random_seed", 42),
    shell:
        """
        POLARS_MAX_THREADS={threads} python {input.script} \
            --indir {params.rdir}/re_variants \
            --peaks {params.rdir}/fastas/peak_ids.txt \
            --out-parquet {output.parquet} \
            --out-tsv {output.tsv} \
            --manifest-dir {params.rdir}/tables \
            --random-n {params.random_n} \
            --seed {params.seed}
        """


rule plot:
    """Interactive tree + FIRE actuation + MSA plot (HTML + PDF from one rule).

The aligned FASTA is temp() but Snakemake keeps it until this rule finishes.
HTML: interactive, zoom/pan, MSA toggle button, toolbar exports SVG.
PDF: static via kaleido (same Plotly figure, scale=2).

The optional ``phylo_mm`` TSV (from rule phylo_mm) feeds the
statistical overlay: header summary (H²_p), and the top variable-site
SNP effect is annotated above the MSA at its alignment column.
"""
    input:
        tree=RESULTS + "/trees/{peak_id}.rooted.nwk",
        actuation=RESULTS + "/fastas/{peak_id}.tsv",
        alignment=TEMP + "/aligned/{peak_id}.fa",
        pclai=_pclai_bed_for_plot,
        phylo_mm=RESULTS + "/phylo_mm/{peak_id}.tsv",
        script=workflow.source_path("scripts/plot_tree_actuation_html.py"),
    output:
        **({"html": RESULTS + "/plots/{category}/{peak_id}.html"} if PLOT_HTML else {}),
        pdf=RESULTS + "/plots/{category}/{peak_id}.pdf",
    params:
        peak_id=lambda wc: wc.peak_id,
        html_arg=lambda wc, output: f"--html {output.html}" if PLOT_HTML else "",
        pclai_arg=lambda wc, input: (
            f"--pclai-bed {shlex.quote(str(input.pclai[0]))}" if input.pclai else ""
        ),
        flank=config.get("flank", 0),
    shell:
        """
        python {input.script} \
            --tree        {input.tree} \
            --actuation   {input.actuation} \
            --alignment   {input.alignment} \
            --pdf         {output.pdf} \
            --peak-id     {params.peak_id} \
            --phylo-mm    {input.phylo_mm} \
            --flank       {params.flank} \
            {params.html_arg} {params.pclai_arg}
        """
